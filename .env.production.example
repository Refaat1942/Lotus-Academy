# Copy to .env on the server (never commit). chmod 600.
POSTGRES_DB=lotus_academy
POSTGRES_USER=lotus
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
APP_URL=https://academy.example.com
# SMTP (transactional email). Without SMTP_HOST, emails are logged as FAILED (not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lotus Academy <no-reply@example.com>"
IMPORT_ON_START=true
# Bind address for the app port. 127.0.0.1 = private (use with Nginx). 0.0.0.0 = reachable directly on http://SERVER_IP:15169
BIND_ADDR=127.0.0.1
